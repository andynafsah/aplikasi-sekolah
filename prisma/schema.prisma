datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model School {
  id              String   @id @default("school-main")
  name            String   @default("SMA Unggulan Nusantara")
  foundation_name String   @default("Yayasan Bina Pemuda Nusantara")
  npsn            String   @default("12345678")
  address         String   @default("Jl. Raya Pendidikan No. 10, Jakarta")
  logo            String   @default("/logo.png")
  favicon         String   @default("/favicon.ico")
  email           String   @default("info@sekolah.sch.id")
  phone           String   @default("021-5551234")
  website         String   @default("www.sekolah.sch.id")
  timezone        String   @default("Asia/Jakarta")
  currency        String   @default("IDR")
  language        String   @default("id")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model AcademicYear {
  id         String     @id @default(uuid())
  name       String     // e.g. "2025/2026"
  status     String     @default("ACTIVE") // "ACTIVE" or "INACTIVE"
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?
  semesters  Semester[]
}

model Semester {
  id               String       @id @default(uuid())
  academic_year_id String
  name             String       // e.g. "Ganjil" or "Genap"
  status           String       @default("ACTIVE")
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
}

model Role {
  id               String           @id @default(uuid())
  name             String
  code             String           @unique
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  role_permissions RolePermission[]
  users            User[]
}

model Permission {
  id               String           @id @default(uuid())
  name             String
  code             String           @unique
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?
  role_permissions RolePermission[]
}

model RolePermission {
  id            String     @id @default(uuid())
  role_id       String
  permission_id String
  created_at    DateTime   @default(now())
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
}

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  username              String      @unique
  password_hash         String
  name                  String
  role_id               String
  phone                 String?
  status                String      @default("ACTIVE")
  photo                 String?
  signature             String?
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  deleted_at            DateTime?
  role                  Role        @relation(fields: [role_id], references: [id])
  audit_logs            AuditLog[]
}

model Teacher {
  id         String     @id @default(uuid())
  name       String
  nip        String?    @unique
  department String?
  position   String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?
}

model TeacherAssignment {
  id               String   @id @default(uuid())
  tenant_id        String   @default("tenant-1")
  teacher_id       String
  unit_id          String
  academic_year_id String
  semester_id      String
  class_id         String
  subject_id       String?
  assignment_type  String   // TEACHER, SUBJECT_TEACHER, HOMEROOM, TAHFIDZ, EXTRACURRICULAR, MUSYRIF
  is_homeroom      Boolean  @default(false)
  status           String   @default("ACTIVE")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  deleted_at       DateTime?

  subject          Subject? @relation(fields: [subject_id], references: [id])

  @@map("teacher_assignments")
}

model Employee {
  id         String     @id @default(uuid())
  name       String
  nip        String?    @unique
  position   String?
  status     String     @default("TETAP")
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?
}

model Student {
  id           String            @id @default(uuid())
  name         String
  nis          String            @unique
  nisn         String?           @unique
  status       String            @default("AKTIF")
  class_id     String?
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  deleted_at   DateTime?
  class        Class?            @relation(fields: [class_id], references: [id])
  parents      Parent[]
  guardians    StudentGuardian[]
  attendance   Attendance[]
  payments     Payment[]
  documents    Document[]
  scores           AssessmentScore[]
  final_scores     StudentFinalScore[]
  rankings         StudentRanking[]
  promotion_results PromotionResult[]
  graduation_results GraduationResult[]
}

model Parent {
  id         String    @id @default(uuid())
  student_id String
  name       String
  email      String?
  phone      String?
  relation   String    // e.g. "Ayah", "Ibu", "Wali"
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  student    Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Guardian {
  id          String            @id @default(uuid())
  name        String
  nik         String?           @unique
  phone       String?
  email       String?
  address     String?
  occupation  String?
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  deleted_at  DateTime?
  students    StudentGuardian[]
}

model StudentGuardian {
  student_id  String
  guardian_id String
  relation    String // e.g. "Ayah", "Ibu", "Wali"
  created_at  DateTime @default(now())

  student     Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  guardian    Guardian @relation(fields: [guardian_id], references: [id], onDelete: Cascade)

  @@id([student_id, guardian_id])
}

model Class {
  id         String     @id @default(uuid())
  name       String     // e.g. "VII-A"
  grade      String     // e.g. "7"
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?
  students   Student[]
}

model Curriculum {
  id           String    @id @default(uuid())
  tenant_id    String    @default("tenant-1")
  code         String    @unique
  name         String    // e.g. "Kurikulum Merdeka 2024"
  description  String?   @db.Text
  academic_year String?  // tahun_ajaran
  semester     String?   // GANJIL, GENAP, BOTH
  level        String?   // jenjang
  unit         String?   // unit
  status       String    @default("ACTIVE")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  subjects     Subject[]

  @@map("curriculums")
}

model SubjectCategory {
  id          String    @id @default(uuid())
  tenant_id   String    @default("tenant-1")
  name        String    // e.g. "Umum", "Diniyah"
  description String?   @db.Text
  color       String?   @default("#64748b")
  icon        String?   @default("Book")
  order       Int       @default(0)
  status      String    @default("ACTIVE")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  subjects    Subject[]

  @@map("subject_categories")
}

model Subject {
  id                 String    @id @default(uuid())
  tenant_id          String    @default("tenant-1")
  category_id        String?
  curriculum_id      String?
  code               String    @unique
  name               String    // e.g. "Matematika"
  name_arabic        String?   // nama_arab
  name_english       String?   // nama_inggris
  level              String?   // jenjang
  unit               String?   // unit
  semester           String?   // GANJIL, GENAP, BOTH
  kkm                Int       @default(75)
  weight             Float?    @default(1.0) // bobot
  hours_per_week     Int?      @default(2)   // jam_per_minggu
  color              String?   @default("#64748b")
  icon               String?   @default("BookOpen")
  order              Int       @default(0)
  is_rapor           Boolean   @default(true)
  is_leger           Boolean   @default(true)
  is_absensi         Boolean   @default(true)
  is_tahfidz         Boolean   @default(false)
  status             String    @default("ACTIVE")
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  category           SubjectCategory? @relation(fields: [category_id], references: [id])
  curriculum         Curriculum?      @relation(fields: [curriculum_id], references: [id])
  learning_outcomes  SubjectCP[]
  learning_objectives SubjectTP[]
  teacher_assignments TeacherAssignment[]
  assessment_formulas AssessmentFormula[]
  scores             AssessmentScore[]
  final_scores       StudentFinalScore[]

  @@map("subjects")
}

model SubjectCP {
  id          String    @id @default(uuid())
  subject_id  String
  level       String?   // jenjang
  semester    String?   // semester
  content     String    @db.Text // Learning Outcome / Capaian Pembelajaran
  order       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  subject     Subject   @relation(fields: [subject_id], references: [id])

  @@map("subject_cp")
}

model SubjectTP {
  id          String    @id @default(uuid())
  subject_id  String
  content     String    @db.Text // Learning Objective / Tujuan Pembelajaran
  order       Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  subject     Subject   @relation(fields: [subject_id], references: [id])

  @@map("subject_tp")
}

model AssessmentType {
  id          String    @id @default(uuid())
  tenant_id   String    @default("tenant-1")
  name        String    // e.g. "Tugas", "UH", "PTS", "PAS"
  code        String    @unique
  weight      Float     @default(1.0)
  status      String    @default("ACTIVE")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  scores      AssessmentScore[]
  components  AssessmentComponent[]

  @@map("assessment_types")
}

model AssessmentComponent {
  id          String    @id @default(uuid())
  tenant_id   String    @default("tenant-1")
  type_id     String?
  name        String    // e.g. "Pengetahuan", "Keterampilan", "Sikap"
  code        String    @unique
  weight      Float     @default(1.0)
  status      String    @default("ACTIVE")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  scores      AssessmentScore[]

  type        AssessmentType? @relation(fields: [type_id], references: [id])

  @@map("assessment_components")
}

model AssessmentFormula {
  id          String    @id @default(uuid())
  tenant_id   String    @default("tenant-1")
  subject_id  String
  name        String    // e.g. "Formula Semester Ganjil"
  formula     String    // e.g. "0.3*Tugas + 0.2*UH + 0.2*PTS + 0.3*PAS"
  status      String    @default("ACTIVE")
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  subject     Subject   @relation(fields: [subject_id], references: [id])

  @@map("assessment_formulas")
}

model AssessmentScore {
  id              String    @id @default(uuid())
  tenant_id       String    @default("tenant-1")
  student_id      String
  subject_id      String
  type_id         String
  component_id    String
  teacher_id      String
  academic_year_id String
  semester        String
  score           Float
  notes           String?   @db.Text
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  student         Student             @relation(fields: [student_id], references: [id])
  subject         Subject             @relation(fields: [subject_id], references: [id])
  type            AssessmentType      @relation(fields: [type_id], references: [id])
  component       AssessmentComponent @relation(fields: [component_id], references: [id])

  @@map("assessment_scores")
}

model StudentFinalScore {
  id               String    @id @default(uuid())
  tenant_id        String    @default("tenant-1")
  student_id       String
  subject_id       String
  academic_year_id String
  semester         String
  score_final      Float
  predicate        String?   // A, B, C, D
  description      String?   @db.Text
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  student          Student   @relation(fields: [student_id], references: [id])
  subject          Subject   @relation(fields: [subject_id], references: [id])

  @@map("student_final_scores")
}

model StudentRanking {
  id               String    @id @default(uuid())
  tenant_id        String    @default("tenant-1")
  student_id       String
  classroom_id     String
  academic_year_id String
  semester         String
  average_score    Float
  rank             Int
  total_students   Int
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  student          Student   @relation(fields: [student_id], references: [id])

  @@map("student_rankings")
}

model ReportTemplate {
  id           String    @id @default(uuid())
  tenant_id    String    @default("tenant-1")
  name         String
  type         String    // MERDEKA, K13, etc.
  is_default   Boolean   @default(false)
  page_size    String    @default("A4") // A4, F4, Legal
  orientation  String    @default("PORTRAIT") // PORTRAIT, LANDSCAPE
  margin_top   Int       @default(20)
  margin_right Int       @default(20)
  margin_bottom Int      @default(20)
  margin_left  Int       @default(20)
  config       String?   @db.Text // JSON for blocks/sections
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@map("report_templates")
}

model PromotionResult {
  id               String    @id @default(uuid())
  tenant_id        String    @default("tenant-1")
  academic_year    String
  student_id       String
  student_name     String
  current_class    String
  next_class       String?
  status           String    @default("PENDING") // PROMOTED, RETAINED, PENDING
  notes            String?   @db.Text
  approved_by      String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  student          Student   @relation(fields: [student_id], references: [id])

  @@map("promotion_results")
}

model GraduationResult {
  id               String    @id @default(uuid())
  tenant_id        String    @default("tenant-1")
  academic_year    String
  student_id       String
  student_name     String
  nis              String
  nisn             String?
  average_score    Float     @default(0)
  status           String    @default("PENDING") // GRADUATED, FAILED, PENDING
  notes            String?   @db.Text
  approved_by      String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  student          Student   @relation(fields: [student_id], references: [id])

  @@map("graduation_results")
}

model Attendance {
  id           String    @id @default(uuid())
  tenant_id    String    @default("system")
  student_id   String?
  user_id      String?
  date         String    // YYYY-MM-DD
  time_in      String?
  time_out     String?
  status       String    // e.g. "HADIR", "SAKIT", "IZIN", "ALFA"
  type         String    @default("STUDENT")
  notes        String?   @db.Text
  location_lat Float?
  location_lng Float?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?
  created_by   String?
  updated_by   String?
  student      Student?  @relation(fields: [student_id], references: [id])
}

model AttendanceRule {
  id          String   @id @default(uuid())
  tenant_id   String   @default("tenant-1")
  content     Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@map("attendance_rules")
}

model ReplacementTeacher {
  id          String   @id @default(uuid())
  tenant_id   String   @default("tenant-1")
  content     Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@map("replacement_teachers")
}

model AttendanceGeofence {
  id          String   @id @default(uuid())
  tenant_id   String   @default("tenant-1")
  content     Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  deleted_at  DateTime?

  @@map("attendance_geofences")
}

model Payment {
  id          String    @id @default(uuid())
  student_id  String
  amount      Float
  payment_for String    // e.g. "SPP Juli 2026"
  status      String    @default("UNPAID") // "PAID", "UNPAID", "PARTIAL"
  paid_at     DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  student     Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model PayrollMaster {
  id                      String    @id @default(uuid())
  tenant_id               String    @default("tenant-1")
  employee_id             String
  employee_name           String
  role                    String
  base_salary             Float
  daily_allowance         Float
  position_allowance      Float
  family_allowance        Float
  certification_allowance Float
  functional_allowance    Float
  pondok_allowance        Float
  bpjs_subsidy            Float
  tax_subsidy             Float
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt
  deleted_at              DateTime?

  @@map("payroll_masters")
}

model PayrollRun {
  id              String    @id @default(uuid())
  tenant_id       String    @default("tenant-1")
  employee_id     String
  payroll_period  String
  data            Json
  approval_status String?
  payment_status  String?
  paid_at         DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  deleted_at      DateTime?

  @@map("payroll_runs")
}

model PayrollLoan {
  id                  String    @id @default(uuid())
  tenant_id           String    @default("tenant-1")
  employee_id         String
  employee_name       String
  loan_amount         Float
  tenor_months        Int
  monthly_installment Float
  remaining_amount    Float
  reason              String?
  approval_status     String
  payment_status      String
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  @@map("payroll_loans")
}

model PayrollKasbon {
  id            String    @id @default(uuid())
  tenant_id     String    @default("tenant-1")
  employee_id   String
  employee_name String
  kasbon_amount Float
  reason        String?
  status        String
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@map("payroll_kasbon")
}

model PayrollAuditLog {
  id          String   @id @default(uuid())
  tenant_id   String   @default("tenant-1")
  actor_id    String
  actor_name  String
  actor_role  String
  action_type String
  module      String
  description String
  payload     String?  @db.Text
  created_at  DateTime @default(now())
  deleted_at  DateTime?

  @@map("payroll_audit_logs")
}

model Finance {
  id          String    @id @default(uuid())
  category    String    // e.g. "SPP", "OPERASIONAL"
  amount      Float
  type        String    // "INCOME" or "EXPENSE"
  description String?
  date        String    // YYYY-MM-DD
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
}

model Inventory {
  id         String    @id @default(uuid())
  item_name  String
  quantity   Int
  location   String?
  status     String    @default("BAIK")
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
}

model Document {
  id         String    @id @default(uuid())
  student_id String
  name       String
  category   String    // e.g. "IJAZAH", "KK", "AKTA"
  file_type  String
  file_size  Int
  file_url   String
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?
  student    Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Notification {
  id           String    @id @default(uuid())
  recipient    String?   // existing recipient or phone/email
  recipient_id String?   // target user_id or recipient identifier
  type         String    // "WHATSAPP", "EMAIL", "SYSTEM", "IN_APP", "PUSH", "CORRECTION", "QR", "GPS", "SECURITY"
  title        String
  message      String
  entity_type  String?
  entity_id    String?
  data         String?   @db.Text // JSON metadata
  read_at      DateTime?
  expires_at   DateTime?
  status       String    @default("PENDING") // "SENT", "PENDING", "FAILED", "UNREAD", "READ"
  tenant_id    String?   @default("system")
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}

model AuditLog {
  id            String   @id @default(uuid())
  tenant_id     String?
  user_id       String?
  user_name     String?
  action        String   // e.g. "INSERT", "UPDATE", "DELETE"
  table_name    String?
  details       String?  @db.Text
  document_type String?
  target_scope  String?
  format        String?
  module        String?
  hash_id       String?
  status        String?
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now())
  user          User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model SystemSetting {
  id         String   @id @default(uuid())
  tenant_id  String   @default("system")
  key        String   @unique
  value      String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, key])
}

model Session {
  id               String    @id @default(uuid())
  user_id          String
  login_date       String
  login_time       String
  ip_address       String?
  browser          String?
  os               String?
  device           String?
  location         String?
  status           String    @default("ACTIVE")
  last_activity_at DateTime  @default(now())
  expires_at       DateTime
  created_at       DateTime  @default(now())
  ended_at         DateTime?
}

model RefreshToken {
  id          String   @id @default(uuid())
  user_id     String
  token       String   @unique @db.VarChar(512)
  expires_at  DateTime
  is_revoked  Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model DapodikChecklist {
  id            String   @id @default(uuid())
  checklist_num Int      @unique
  title         String
  status        String   @default("Belum") // Belum, Proses, Selesai
  tanggal       String?  // YYYY-MM-DD
  pic           String?  // Penanggung Jawab
  catatan       String?  // Notes
  lampiran_name String?  // Name of attached file
  lampiran_url  String?  // URL of attached file
  custom_fields String?  // JSON-stringified details for specific checklist requirements
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model DapodikLog {
  id            String   @id @default(uuid())
  checklist_num Int
  username      String
  action        String   // TAMBAH, EDIT, UPLOAD, HAPUS, VALIDASI
  details       String   // Descriptive message or JSON
  created_at    DateTime @default(now())
}

model Announcement {
  id                String                  @id @default(uuid())
  title             String
  content           String                  @db.Text
  type              String                  // "Informasi", "Akademik", "Keuangan", "PPDB", "Kegiatan", "Libur", "Ujian", "Rapat", "Tahfidz", "Asrama", "Darurat"
  priority          String                  @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  is_pinned         Boolean                 @default(false)
  status            String                  @default("Draft") // "Draft", "Scheduled", "Sending", "Sent", "Failed", "Expired", "Archived"
  sender_id         String?
  sender_name       String?
