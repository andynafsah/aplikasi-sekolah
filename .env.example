# ============================================================
# SCHOOL / PESANTREN ERP - ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
VERIFICATION_URL=http://localhost:3000/verify

# Database Configuration (PostgreSQL / MySQL compatible)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=10000

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_min_32_characters_random
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_min_32_random
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Storage Configuration
STORAGE_DRIVER=local
STORAGE_URL=http://localhost:3000/storage
UPLOAD_PATH=./storage/uploads
MAX_FILE_SIZE_MB=10

# Geolocation & Maps
GOOGLE_MAPS_API_KEY=

# Mail / SMTP Notification
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@schoolerp.sch.id

# Redis & Cache (Optional / Graceful Fallback)
REDIS_URL=redis://localhost:6379

# AI & Gemini Assistant
GEMINI_API_KEY=
